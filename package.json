{
  "name": "studyforge-ai",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run dev --workspace @studyforge/web",
    "build": "npm run db:generate && npm run build --workspace @studyforge/web",
    "start": "npm run start --workspace @studyforge/web",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @studyforge/web",
    "check:auth": "tsx scripts/check-auth.ts",
    "test:browser:auth": "node --import tsx scripts/test_auth_browser.mjs",
    "test:browser:quiz": "node --import tsx scripts/test_quiz_browser.mjs",
    "test:browser:documents": "node --import tsx scripts/test_document_studio.mjs",
    "test:browser:workspace": "node --import tsx scripts/test_workspace_upgrade.mjs",
    "test:browser:images": "node --import tsx scripts/test_assistant_images.mjs",
    "check:quiz:ai": "node --import tsx scripts/check-quiz-ai.ts",
    "check:quiz:web": "node --import tsx scripts/check-quiz-web.mjs",
    "check:database": "node --import tsx scripts/check-database-recovery.mjs",
    "test": "vitest run",
    "test:integration": "node scripts/integration.mjs",
    "db:generate": "node scripts/db.mjs generate",
    "db:push": "node scripts/db.mjs push",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:import:sqlite": "tsx scripts/import-sqlite-to-postgres.ts",
    "db:validate": "node scripts/db.mjs validate",
    "db:seed": "tsx packages/db/seed.ts",
    "postinstall": "npm run db:generate"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "6.19.3",
    "@xmldom/xmldom": "^0.8.15",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "mammoth": "^1.11.0",
    "nodemailer": "^7.0.10",
    "pdf-parse": "^2.4.5",
    "server-only": "^0.0.1",
    "ws": "^8.22.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.3",
    "@types/ws": "^8.18.2",
    "playwright": "^1.64.1",
    "prisma": "6.19.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
