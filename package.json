{
  "name": "studyforge-ai",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "npm run dev --workspace @studyforge/web",
    "build": "npm run build --workspace @studyforge/web",
    "start": "npm run start --workspace @studyforge/web",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @studyforge/web",
    "test": "vitest run",
    "test:integration": "node scripts/integration.mjs",
    "db:generate": "node scripts/db.mjs generate",
    "db:push": "node scripts/db.mjs push",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:validate": "node scripts/db.mjs validate",
    "db:seed": "tsx packages/db/seed.ts",
    "postinstall": "npm run db:generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "mammoth": "^1.11.0",
    "nodemailer": "^7.0.10",
    "pdf-parse": "^2.4.5",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.3",
    "prisma": "6.19.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
