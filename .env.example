# Copy to .env at repository root. Never use NEXT_PUBLIC_* for credentials.
APP_URL=http://localhost:3000
# Google Cloud Console -> OAuth client -> Web application. Server-side only.
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# PostgreSQL for production. Omit DATABASE_URL for local SQLite fallback.
DATABASE_URL=postgresql://studyforge:CHANGE_ME@localhost:5432/studyforge?schema=public
# Optional SQLite override (absolute file: URL recommended on Windows).
# SQLITE_DATABASE_URL=file:C:/path/to/studyforge/.data/dev.db
SESSION_TTL_DAYS=7
AUTH_BCRYPT_ROUNDS=12
# 0 for local HTTP; production always uses Secure cookies.
COOKIE_SECURE=0
PRIVATE_STORAGE_DIR=.data/uploads
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_FILES=5
# SMTP delivery is required in production. Local development writes verification
# emails to private .data/mail/*.json, never to public API responses.
MAIL_TRANSPORT=file
MAIL_FROM=StudyForge <noreply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Include /v1 if your 9Router exposes /v1/chat/completions.
AI_BASE_URL=http://127.0.0.1:20128/v1
AI_API_KEY=
AI_MODEL_GENERATE=gemini-2.5-flash
AI_MODEL_REVIEW=gemini-2.5-pro
AI_TIMEOUT_MS=120000
# Database-backed rate limits; no Redis required.
AUTH_RATE_LIMIT_PER_15_MIN=20
UPLOAD_RATE_LIMIT_PER_15_MIN=20
AI_RATE_LIMIT_PER_15_MIN=10
ATTEMPT_RATE_LIMIT_PER_15_MIN=60
