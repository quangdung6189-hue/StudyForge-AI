generator client {
  provider = "prisma-client-js"
  output   = "../.generated/postgres"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator neonClient {
  provider = "prisma-client-js"
  output = "../.generated/neon"
  engineType = "client"
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  name            String
  passwordHash    String?
  googleSubject   String?   @unique
  lastLoginAt     DateTime?
  role            String    @default("student")
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sessions        Session[]
  tokens          VerificationToken[]
  documents       Document[]
  banks           QuestionBank[]
  quizzes         Quiz[]
  attempts        Attempt[]
  googleAuthAttempts GoogleAuthAttempt[]
  documentUploads DocumentUpload[]
  attemptRecords  AttemptRecord[]
  reviewCards     ReviewCard[]
  reviewLogs      ReviewLog[]
  ownedClasses    Classroom[]
  classMemberships ClassMember[]
  mediaAssets     MediaAsset[]
}

// Short-lived, single-use state for Google OAuth; never stores Google passwords.
model GoogleAuthAttempt {
  id               String   @id @default(uuid())
  stateHash        String   @unique
  browserTokenHash String
  nonceHash        String
  codeVerifier     String
  userId           String?
  expiresAt        DateTime
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model VerificationToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  purpose   String   @default("verify_email")
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose])
}

model Document {
  id         String   @id @default(uuid())
  ownerId    String
  title      String
  fileType   String
  size       Int
  storageKey String   @unique
  status     String   @default("uploaded")
  rawText    String?
  errorCode  String?
  revision   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  chunks     DocumentChunk[]
  banks      QuestionBank[]
  original   DocumentFile?
  @@index([ownerId, createdAt])
}

// Private originals are never selected by document list/detail queries.
model DocumentFile {
  documentId String   @id
  content    Bytes
  metadata   Json?
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

// Bounded, expiring uploads. No part is publicly readable or addressable by URL.
model DocumentUpload {
  id            String   @id @default(uuid())
  ownerId       String
  filename      String
  fileType      String
  size          Int
  receivedBytes Int      @default(0)
  nextPart      Int      @default(0)
  status        String   @default("uploading")
  documentId    String?
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parts         DocumentUploadPart[]
  @@index([ownerId, expiresAt])
  @@index([expiresAt])
}

model DocumentUploadPart {
  uploadId String
  position Int
  checksum String
  content  Bytes
  upload   DocumentUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  @@id([uploadId, position])
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  chunkIndex Int
  content    String
  pageNumber Int?
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@unique([documentId, chunkIndex])
}

model QuestionBank {
  id         String   @id @default(uuid())
  ownerId    String
  documentId String
  title      String
  createdAt  DateTime @default(now())
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  questions  Question[]
  quiz       Quiz?
  @@index([ownerId, documentId])
}

model Question {
  id               String   @id @default(uuid())
  bankId           String
  position         Int
  type             String
  stem             String
  correctOptionIds Json
  acceptedAnswers  Json
  explanation      String
  points           Float    @default(1)
  difficulty       String   @default("recognition")
  topic            String   @default("")
  answerOrigin     String   @default("ai_suggested")
  sourceRefs       Json
  reviewed         Boolean  @default(false)
  // matching: [{ leftId, rightId }] over this question's options
  pairs            Json?
  audioAssetId     String?
  // Teacher rubric for AI-assisted grading of short/fill answers
  rubric           String?
  tags             Json?
  bank             QuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)
  options          QuestionOption[]
  @@unique([bankId, position])
}

model QuestionOption {
  id         String @id @default(uuid())
  questionId String
  position   Int
  text       String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  @@unique([questionId, position])
}

model Quiz {
  id                String   @id @default(uuid())
  ownerId           String
  bankId            String   @unique
  title             String
  description       String   @default("")
  durationMinutes   Int      @default(30)
  deadline          DateTime?
  allowReview       Boolean  @default(false)
  isPublished       Boolean  @default(false)
  shareCode         String?  @unique
  publishedVersion  Int      @default(0)
  opensAt           DateTime?
  maxAttempts       Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  owner             User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bank              QuestionBank @relation(fields: [bankId], references: [id], onDelete: Restrict)
  versions          QuizVersion[]
  attempts          Attempt[]
  records           AttemptRecord[]
  assignments       Assignment[]
  @@index([ownerId, createdAt])
}

// Immutable: application only creates versions, never updates/deletes them.
model QuizVersion {
  id        String   @id @default(uuid())
  quizId    String
  version   Int
  snapshot  Json
  createdAt DateTime @default(now())
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Restrict)
  attempts  Attempt[]
  @@unique([quizId, version])
}

model Attempt {
  id            String   @id @default(uuid())
  userId        String
  quizId        String
  quizVersionId String
  seed          String
  startedAt     DateTime @default(now())
  expiresAt     DateTime
  submittedAt   DateTime?
  status        String   @default("started")
  score         Float?
  totalPoints   Float?
  passed        Boolean?
  result        Json?
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Restrict)
  quizVersion   QuizVersion @relation(fields: [quizVersionId], references: [id], onDelete: Restrict)
  answers       AttemptAnswer[]
  @@unique([userId, quizVersionId])
  @@index([userId, status])
  @@index([status, expiresAt])
}

model AttemptAnswer {
  id         String   @id @default(uuid())
  attemptId  String
  questionId String
  values     Json
  savedAt    DateTime @default(now())
  // Practice mode: set once the learner checks this answer; it is then locked.
  checkedAt  DateTime?
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  @@unique([attemptId, questionId])
}

// Immutable log of every submission (a retry reuses Attempt, never this row).
model AttemptRecord {
  id            String   @id @default(uuid())
  attemptId     String
  userId        String
  quizId        String
  quizVersionId String
  score         Float
  totalPoints   Float
  passed        Boolean
  startedAt     DateTime
  submittedAt   DateTime @default(now())
  // Decoded answers keyed by real question id (never exposed to other students)
  answers       Json
  result        Json
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  overrides     GradingOverride[]
  @@index([userId, submittedAt])
  @@index([quizId, submittedAt])
}

// AI-suggested or teacher-confirmed points for one text answer of one submission.
model GradingOverride {
  id           String   @id @default(uuid())
  recordId     String
  questionId   String
  points       Float
  feedback     String   @default("")
  origin       String   @default("ai_suggested")
  status       String   @default("suggested")
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
  record       AttemptRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  @@unique([recordId, questionId])
}

// Spaced-repetition card with an immutable content snapshot.
model ReviewCard {
  id           String   @id @default(uuid())
  userId       String
  sourceKey    String
  deck         String
  front        String
  back         String
  explanation  String   @default("")
  citation     String   @default("")
  easeFactor   Float    @default(2.5)
  intervalDays Int      @default(0)
  repetitions  Int      @default(0)
  lapses       Int      @default(0)
  dueAt        DateTime @default(now())
  lastReviewedAt DateTime?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs         ReviewLog[]
  @@unique([userId, sourceKey])
  @@index([userId, dueAt])
  @@index([userId, deck])
}

model ReviewLog {
  id         String   @id @default(uuid())
  cardId     String
  userId     String
  rating     Int
  reviewedAt DateTime @default(now())
  card       ReviewCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, reviewedAt])
}

model Classroom {
  id        String   @id @default(uuid())
  ownerId   String
  name      String
  joinCode  String   @unique
  createdAt DateTime @default(now())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members   ClassMember[]
  assignments Assignment[]
  @@index([ownerId, createdAt])
}

model ClassMember {
  classId  String
  userId   String
  joinedAt DateTime @default(now())
  classroom Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([classId, userId])
  @@index([userId])
}

model Assignment {
  id        String   @id @default(uuid())
  classId   String
  quizId    String
  dueAt     DateTime?
  note      String   @default("")
  createdAt DateTime @default(now())
  classroom Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)
  quiz      Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  @@unique([classId, quizId])
  @@index([classId, createdAt])
}

// Small private media (question audio). Readable only by signed-in users via an unguessable id.
model MediaAsset {
  id        String   @id @default(uuid())
  ownerId   String
  mimeType  String
  size      Int
  content   Bytes
  createdAt DateTime @default(now())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@index([ownerId, createdAt])
}

model RateLimitBucket {
  id        String   @id
  count     Int      @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
