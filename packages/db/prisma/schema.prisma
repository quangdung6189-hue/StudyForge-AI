generator client {
  provider = "prisma-client-js"
  output   = "../.generated/postgres"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator neonClient {
  provider = "prisma-client-js"
  output = "../.generated/neon"
  engineType = "client"
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  name            String
  passwordHash    String?
  googleSubject   String?   @unique
  lastLoginAt     DateTime?
  role            String    @default("student")
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sessions        Session[]
  tokens          VerificationToken[]
  documents       Document[]
  banks           QuestionBank[]
  quizzes         Quiz[]
  attempts        Attempt[]
  googleAuthAttempts GoogleAuthAttempt[]
}

// Short-lived, single-use state for Google OAuth; never stores Google passwords.
model GoogleAuthAttempt {
  id               String   @id @default(uuid())
  stateHash        String   @unique
  browserTokenHash String
  nonceHash        String
  codeVerifier     String
  userId           String?
  expiresAt        DateTime
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model VerificationToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  purpose   String   @default("verify_email")
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose])
}

model Document {
  id         String   @id @default(uuid())
  ownerId    String
  title      String
  fileType   String
  size       Int
  storageKey String   @unique
  status     String   @default("uploaded")
  rawText    String?
  errorCode  String?
  revision   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  chunks     DocumentChunk[]
  banks      QuestionBank[]
  @@index([ownerId, createdAt])
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  chunkIndex Int
  content    String
  pageNumber Int?
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@unique([documentId, chunkIndex])
}

model QuestionBank {
  id         String   @id @default(uuid())
  ownerId    String
  documentId String
  title      String
  createdAt  DateTime @default(now())
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  questions  Question[]
  quiz       Quiz?
  @@index([ownerId, documentId])
}

model Question {
  id               String   @id @default(uuid())
  bankId           String
  position         Int
  type             String
  stem             String
  correctOptionIds Json
  acceptedAnswers  Json
  explanation      String
  points           Float    @default(1)
  difficulty       String   @default("recognition")
  topic            String   @default("")
  answerOrigin     String   @default("ai_suggested")
  sourceRefs       Json
  reviewed         Boolean  @default(false)
  bank             QuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)
  options          QuestionOption[]
  @@unique([bankId, position])
}

model QuestionOption {
  id         String @id @default(uuid())
  questionId String
  position   Int
  text       String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  @@unique([questionId, position])
}

model Quiz {
  id                String   @id @default(uuid())
  ownerId           String
  bankId            String   @unique
  title             String
  description       String   @default("")
  durationMinutes   Int      @default(30)
  deadline          DateTime?
  allowReview       Boolean  @default(false)
  isPublished       Boolean  @default(false)
  shareCode         String?  @unique
  publishedVersion  Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  owner             User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bank              QuestionBank @relation(fields: [bankId], references: [id], onDelete: Restrict)
  versions          QuizVersion[]
  attempts          Attempt[]
  @@index([ownerId, createdAt])
}

// Immutable: application only creates versions, never updates/deletes them.
model QuizVersion {
  id        String   @id @default(uuid())
  quizId    String
  version   Int
  snapshot  Json
  createdAt DateTime @default(now())
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Restrict)
  attempts  Attempt[]
  @@unique([quizId, version])
}

model Attempt {
  id            String   @id @default(uuid())
  userId        String
  quizId        String
  quizVersionId String
  seed          String
  startedAt     DateTime @default(now())
  expiresAt     DateTime
  submittedAt   DateTime?
  status        String   @default("started")
  score         Float?
  totalPoints   Float?
  passed        Boolean?
  result        Json?
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Restrict)
  quizVersion   QuizVersion @relation(fields: [quizVersionId], references: [id], onDelete: Restrict)
  answers       AttemptAnswer[]
  @@unique([userId, quizVersionId])
  @@index([userId, status])
  @@index([status, expiresAt])
}

model AttemptAnswer {
  id         String   @id @default(uuid())
  attemptId  String
  questionId String
  values     Json
  savedAt    DateTime @default(now())
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  @@unique([attemptId, questionId])
}

model RateLimitBucket {
  id        String   @id
  count     Int      @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
